        "state": "self\\._\\w+\\s*(?::[^=\\n]+)?=\\s*(?:\\{\\}|dict\\(|OrderedDict|set\\(\\)|\\[\\]|defaultdict)|_cache\\b|lru_cache|\\bglobal\\b",
        "ids": "\\b\\w*_id\\b|\\bids\\b",
        "io": "\\bopen\\(|\\.write_\\w+\\(|\\.unlink\\(|\\.rename\\(|\\.replace\\(|\\bshutil\\.|os\\.replace|\\.mkdir\\(",
        "db": "\\.commit\\(|\\.rollback\\(|[Ss]ession\\b|\\.execute\\(|\\bcursor\\(",
        "errors": "\\bexcept\\b"
      }
    },
