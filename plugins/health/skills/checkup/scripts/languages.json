      "keywords": ["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "export", "extends", "finally", "for", "function", "if", "import", "in", "instanceof", "let", "new", "return", "super", "switch", "this", "throw", "try", "typeof", "var", "void", "while", "with", "yield", "async", "await", "of", "null", "undefined", "true", "false", "static", "get", "set", "interface", "type", "enum", "implements", "private", "protected", "public", "readonly", "abstract", "as", "declare", "namespace", "keyof"],
